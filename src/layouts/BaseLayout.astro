---
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  active?: string;
}

const { title, description, active } = Astro.props;
const fullTitle = active ? `${title} · DevToys` : title;

---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Applied before first paint to avoid a theme flash.
      (function () {
        try {
          var stored = localStorage.getItem('devtoys:theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          if (localStorage.getItem('devtoys:sidebar') === 'collapsed') {
            document.documentElement.dataset.sidebar = 'collapsed';
          }
        } catch (e) {
          /* private mode — fall back to defaults */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Sidebar active={active} />
    <div class="scrim" id="scrim" hidden></div>

    <div class="shell">
      <header class="topbar">
        <button
          type="button"
          class="btn btn-icon"
          id="nav-toggle"
          aria-label="Toggle navigation"
          aria-controls="sidebar"
        >
          <Icon name="menu-line" size={18} />
        </button>

        <div class="topbar-title">
          <h1>{title}</h1>
          <p>{description}</p>
        </div>

        <div class="topbar-actions">
          <button
            type="button"
            class="btn btn-icon theme-btn"
            id="theme-toggle"
            aria-label="Toggle color theme"
            title="Toggle theme"
          >
            <span class="icon-light"><Icon name="sun-line" size={18} /></span>
            <span class="icon-dark"><Icon name="moon-line" size={18} /></span>
          </button>
          <a
            class="btn btn-icon"
            href="https://github.com/ayozehd/devtoys"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Source on GitHub"
            title="Source on GitHub"
          >
            <Icon name="github-line" size={18} />
          </a>
        </div>
      </header>

      <main id="main" class="content">
        <slot />
      </main>

      <footer class="footer">
        <span>Everything runs locally in your browser — nothing is uploaded.</span>
      </footer>
    </div>

    <script>
      import { initCopyButtons } from '../lib/dom';

      initCopyButtons();

      const body = document.body;
      const root = document.documentElement;

      if (root.dataset.sidebar === 'collapsed') body.classList.add('is-collapsed');

      const mobile = () => window.matchMedia('(max-width: 900px)').matches;
      const scrim = document.getElementById('scrim') as HTMLElement | null;

      function setDrawer(open: boolean) {
        body.classList.toggle('nav-open', open);
        if (scrim) scrim.hidden = !open;
      }

      function toggleSidebar() {
        if (mobile()) {
          setDrawer(!body.classList.contains('nav-open'));
          return;
        }
        const collapsed = body.classList.toggle('is-collapsed');
        try {
          localStorage.setItem('devtoys:sidebar', collapsed ? 'collapsed' : 'expanded');
        } catch {
          /* ignore */
        }
        document
          .getElementById('collapse-btn')
          ?.setAttribute('aria-expanded', String(!collapsed));
      }

      document.getElementById('nav-toggle')?.addEventListener('click', toggleSidebar);
      document.getElementById('collapse-btn')?.addEventListener('click', toggleSidebar);
      scrim?.addEventListener('click', () => setDrawer(false));

      // Close the drawer when navigating or resizing back to desktop.
      document.getElementById('sidebar-nav')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && mobile()) setDrawer(false);
      });
      window.addEventListener('resize', () => {
        if (!mobile()) setDrawer(false);
      });

      // ---- Theme -------------------------------------------------------------
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('devtoys:theme', next);
        } catch {
          /* ignore */
        }
      });

      // ---- Sidebar filter ----------------------------------------------------
      const search = document.getElementById('tool-search') as HTMLInputElement | null;
      const navEmpty = document.getElementById('nav-empty');

      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        let visible = 0;

        document.querySelectorAll<HTMLElement>('.nav-group').forEach((group) => {
          let groupHits = 0;
          group.querySelectorAll<HTMLElement>('.nav-link').forEach((link) => {
            const hit = !q || (link.dataset.name || '').includes(q);
            link.parentElement!.hidden = !hit;
            if (hit) groupHits++;
          });
          group.hidden = groupHits === 0;
          visible += groupHits;
        });

        if (navEmpty) navEmpty.hidden = visible > 0;
      });

      // ---- Keyboard shortcuts ------------------------------------------------
      document.addEventListener('keydown', (e) => {
        const el = document.activeElement;
        const typing =
          el instanceof HTMLInputElement ||
          el instanceof HTMLTextAreaElement ||
          el instanceof HTMLSelectElement ||
          (el as HTMLElement)?.isContentEditable;

        if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
          e.preventDefault();
          if (mobile()) setDrawer(true);
          else body.classList.remove('is-collapsed');
          search?.focus();
          search?.select();
        }
        if (e.key === 'Escape') {
          if (body.classList.contains('nav-open')) setDrawer(false);
          else if (el === search && search) {
            search.value = '';
            search.dispatchEvent(new Event('input'));
            search.blur();
          }
        }
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 8px;
    top: -60px;
    z-index: 100;
    padding: 8px 14px;
    color: var(--fg-on-emphasis);
    background: var(--accent-emphasis);
    border-radius: var(--radius-sm);
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 8px;
  }

  .shell {
    min-height: 100dvh;
    margin-left: var(--sidebar-w);
    display: flex;
    flex-direction: column;
    transition: margin-left 0.18s ease;
  }

  :global(body.is-collapsed) .shell {
    margin-left: var(--sidebar-w-collapsed);
  }

  .scrim {
    position: fixed;
    inset: 0;
    z-index: 35;
    background: rgba(1, 4, 9, 0.5);
    backdrop-filter: blur(1px);
  }

  /* ---- Topbar ---- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--header-h);
    padding: 10px 20px;
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  #nav-toggle {
    display: none;
    flex-shrink: 0;
  }

  :global(body.is-collapsed) #nav-toggle {
    display: inline-flex;
  }

  .topbar-title {
    min-width: 0;
    flex: 1;
  }

  .topbar-title h1 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-title p {
    font-size: 12.5px;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .theme-btn .icon-dark,
  :global([data-theme='dark']) .theme-btn .icon-light {
    display: none;
  }

  :global([data-theme='dark']) .theme-btn .icon-dark {
    display: block;
  }

  /* ---- Content ---- */
  .content {
    flex: 1;
    width: 100%;
    max-width: 1280px;
    padding: 20px;
    margin: 0 auto;
  }

  .footer {
    padding: 16px 20px 24px;
    font-size: 12px;
    color: var(--fg-subtle);
    text-align: center;
    border-top: 1px solid var(--border-muted);
  }

  @media (max-width: 900px) {
    .shell,
    :global(body.is-collapsed) .shell {
      margin-left: 0;
    }

    #nav-toggle,
    :global(body.is-collapsed) #nav-toggle {
      display: inline-flex;
    }

    .topbar {
      padding: 10px 14px;
    }

    .topbar-title p {
      display: none;
    }

    .content {
      padding: 16px 14px 24px;
    }
  }

  @media (min-width: 901px) {
    .scrim {
      display: none;
    }
  }
</style>

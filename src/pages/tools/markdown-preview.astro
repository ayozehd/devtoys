---
import ToolLayout from '../../layouts/ToolLayout.astro';
import CopyButton from '../../components/CopyButton.astro';

const SAMPLE = `# DevToys

A collection of **offline** developer utilities.

## Why

- No accounts, no uploads, no tracking
- Works after the first load, even offline
- Built with [Astro](https://astro.build) and plain web APIs

> Everything you paste stays in this tab.

### Quick start

\`\`\`bash
npm install
npm run dev
\`\`\`

| Tool | Category | Offline |
| ---- | -------- | :-----: |
| Regex tester | Text | ✅ |
| Cron builder | Time | ✅ |
| Image tools | Media | ✅ |

1. Pick a tool from the sidebar
2. Paste your input
3. Copy the result

---

Inline \`code\`, ~~strikethrough~~, and a task list:

- [x] Ship the layout
- [ ] Add more tools
`;
---

<ToolLayout slug="markdown-preview">
  <section class="card card-pad">
    <div class="toolbar">
      <div class="segmented" id="view">
        <button type="button" data-value="split" aria-selected="true">Split</button>
        <button type="button" data-value="editor">Editor</button>
        <button type="button" data-value="preview">Preview</button>
        <button type="button" data-value="html">HTML</button>
      </div>
      <label class="check"><input type="checkbox" id="breaks" checked /><span>Treat newlines as line breaks</span></label>
      <div class="spacer"></div>
      <span class="badge badge-neutral" id="stats"></span>
      <button type="button" class="btn btn-sm" id="sample">Load sample</button>
      <button type="button" class="btn btn-sm" id="download-html">Download .html</button>
      <button type="button" class="btn btn-sm" id="download-md">Download .md</button>
    </div>
  </section>

  <div class="panes" id="panes">
    <section class="card pane" id="pane-editor">
      <div class="card-head">
        <span class="card-title">Markdown</span>
        <CopyButton target="input" label="Copy Markdown" />
      </div>
      <div class="card-pad">
        <textarea id="input" class="textarea editor" spellcheck="false">{SAMPLE}</textarea>
      </div>
    </section>

    <section class="card pane" id="pane-preview">
      <div class="card-head">
        <span class="card-title">Preview</span>
        <span class="badge badge-neutral">Sanitised</span>
      </div>
      <div id="preview" class="md-preview"></div>
    </section>

    <section class="card pane" id="pane-html" hidden>
      <div class="card-head">
        <span class="card-title">HTML export</span>
        <div class="row">
          <label class="check"><input type="checkbox" id="full-doc" /><span>Full document</span></label>
          <CopyButton target="html-out" label="Copy HTML" />
        </div>
      </div>
      <pre id="html-out" class="output"></pre>
    </section>
  </div>
</ToolLayout>

<script>
  import DOMPurify from 'dompurify';
  import { marked } from 'marked';
  import { $, download as save, live, segmented } from '../../lib/dom';
  import { fullDocument, readingStats } from '../../lib/markdown';

  const inputEl = $<HTMLTextAreaElement>('#input');
  const breaksEl = $<HTMLInputElement>('#breaks');
  const fullDocEl = $<HTMLInputElement>('#full-doc');
  const previewEl = $('#preview');
  const htmlOut = $('#html-out');

  const SAMPLE = inputEl.value;
  let view = 'split';

  marked.setOptions({ gfm: true });

  // Links out of a preview should never inherit the opener's context.
  DOMPurify.addHook('afterSanitizeAttributes', (node) => {
    if (node instanceof HTMLAnchorElement && node.hasAttribute('href')) {
      node.setAttribute('target', '_blank');
      node.setAttribute('rel', 'noopener noreferrer nofollow');
    }
  });

  function render() {
    const markdown = inputEl.value;
    marked.setOptions({ breaks: breaksEl.checked });

    const raw = marked.parse(markdown, { async: false }) as string;
    const clean = DOMPurify.sanitize(raw, { USE_PROFILES: { html: true }, ADD_ATTR: ['target'] });

    previewEl.innerHTML = clean;
    htmlOut.textContent = fullDocEl.checked ? fullDocument(clean) : clean;

    const stats = readingStats(markdown);
    $('#stats').textContent = `${stats.words} words · ${stats.lines} lines · ~${stats.minutes} min read`;
  }

  segmented($('#view'), (value) => {
    view = value;
    const panes = $('#panes');
    panes.dataset.view = view;
    $('#pane-editor').hidden = view === 'preview' || view === 'html';
    $('#pane-preview').hidden = view === 'editor' || view === 'html';
    $('#pane-html').hidden = view !== 'html';
  });

  $('#sample').addEventListener('click', () => {
    inputEl.value = SAMPLE;
    render();
  });

  $('#download-html').addEventListener('click', () =>
    save('document.html', fullDocument(previewEl.innerHTML), 'text/html'),
  );

  $('#download-md').addEventListener('click', () =>
    save('document.md', inputEl.value, 'text/markdown'),
  );

  live([inputEl, breaksEl, fullDocEl], render);
</script>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .spacer {
    flex: 1;
  }

  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px;
  }

  .panes[data-view='editor'],
  .panes[data-view='preview'],
  .panes[data-view='html'] {
    grid-template-columns: minmax(0, 1fr);
  }

  .editor {
    min-height: 62vh;
    resize: vertical;
  }

  .md-preview {
    padding: 20px 24px;
    min-height: 62vh;
    max-height: 78vh;
    overflow-y: auto;
    line-height: 1.65;
  }

  /* GitHub-ish typography for rendered Markdown. */
  .md-preview :global(h1),
  .md-preview :global(h2) {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-muted);
  }

  .md-preview :global(h1) {
    font-size: 26px;
    margin: 20px 0 14px;
  }

  .md-preview :global(h2) {
    font-size: 21px;
    margin: 24px 0 12px;
  }

  .md-preview :global(h3) {
    font-size: 17px;
    margin: 20px 0 10px;
  }

  .md-preview :global(h4),
  .md-preview :global(h5),
  .md-preview :global(h6) {
    font-size: 15px;
    margin: 16px 0 8px;
  }

  .md-preview :global(p),
  .md-preview :global(ul),
  .md-preview :global(ol),
  .md-preview :global(blockquote),
  .md-preview :global(table),
  .md-preview :global(pre) {
    margin: 0 0 14px;
  }

  .md-preview :global(ul),
  .md-preview :global(ol) {
    padding-left: 24px;
    list-style: revert;
  }

  .md-preview :global(li) {
    margin-bottom: 4px;
  }

  .md-preview :global(li input[type='checkbox']) {
    margin-right: 6px;
  }

  .md-preview :global(code) {
    font-family: var(--font-mono);
    font-size: 85%;
    padding: 2px 6px;
    background: var(--neutral-muted);
    border-radius: 5px;
  }

  .md-preview :global(pre) {
    padding: 14px;
    overflow-x: auto;
    background: var(--canvas-subtle);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-sm);
  }

  .md-preview :global(pre code) {
    padding: 0;
    background: none;
    font-size: 12.5px;
  }

  .md-preview :global(blockquote) {
    padding: 2px 16px;
    color: var(--fg-muted);
    border-left: 4px solid var(--border);
  }

  .md-preview :global(table) {
    width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }

  .md-preview :global(th),
  .md-preview :global(td) {
    padding: 6px 12px;
    border: 1px solid var(--border);
  }

  .md-preview :global(th) {
    background: var(--canvas-subtle);
  }

  .md-preview :global(hr) {
    height: 1px;
    margin: 20px 0;
    background: var(--border);
    border: none;
  }

  .md-preview :global(img) {
    max-width: 100%;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor,
    .md-preview {
      min-height: 44vh;
    }
  }
</style>

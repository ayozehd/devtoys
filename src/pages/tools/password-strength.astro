---
import ToolLayout from '../../layouts/ToolLayout.astro';
import CopyButton from '../../components/CopyButton.astro';
---

<ToolLayout slug="password-strength">
  <section class="card">
    <div class="card-head">
      <span class="card-title">Test a password</span>
      <div class="row">
        <label class="check"><input type="checkbox" id="reveal" /><span>Reveal</span></label>
      </div>
    </div>
    <div class="card-pad stack">
      <input
        id="password"
        class="input mono big"
        type="password"
        autocomplete="new-password"
        spellcheck="false"
        placeholder="Type or paste a password…"
        aria-describedby="verdict"
      />

      <div class="meter" aria-hidden="true">
        <div class="meter-fill" id="meter"></div>
      </div>

      <div class="row summary">
        <span class="badge" id="verdict">Waiting</span>
        <span class="badge badge-neutral" id="entropy">0 bits</span>
        <span class="badge badge-neutral" id="pool">pool 0</span>
        <span class="badge badge-neutral" id="length">0 chars</span>
      </div>

      <p class="hint">
        Nothing you type is stored or sent anywhere. Entropy assumes an attacker knows the character
        set you used — the realistic worst case.
      </p>
    </div>
  </section>

  <div class="grid-2">
    <section class="card">
      <div class="card-head"><span class="card-title">Time to crack</span></div>
      <div class="table-wrap">
        <table class="data" id="crack">
          <thead>
            <tr><th>Attacker</th><th>Guesses / second</th><th>Average time</th></tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="card-head"><span class="card-title">Checks</span></div>
      <ul class="checks" id="checks"></ul>
    </section>
  </div>

  <section class="card card-pad">
    <div class="toolbar">
      <div class="field">
        <span class="label">Generate</span>
        <div class="segmented" id="gen-mode">
          <button type="button" data-value="random" aria-selected="true">Random</button>
          <button type="button" data-value="passphrase">Passphrase</button>
          <button type="button" data-value="pin">PIN</button>
        </div>
      </div>

      <label class="field" id="opt-length">
        <span class="label">Length <b id="len-out">20</b></span>
        <input type="range" id="gen-length" min="6" max="64" value="20" class="range" />
      </label>

      <label class="field" id="opt-words" hidden>
        <span class="label">Words <b id="words-out">5</b></span>
        <input type="range" id="gen-words" min="3" max="10" value="5" class="range" />
      </label>

      <div class="field" id="opt-sets">
        <span class="label">Include</span>
        <div class="row">
          <label class="check"><input type="checkbox" class="js-set" value="lower" checked /><span>a–z</span></label>
          <label class="check"><input type="checkbox" class="js-set" value="upper" checked /><span>A–Z</span></label>
          <label class="check"><input type="checkbox" class="js-set" value="digits" checked /><span>0–9</span></label>
          <label class="check"><input type="checkbox" class="js-set" value="symbols" checked /><span>symbols</span></label>
          <label class="check"><input type="checkbox" id="no-ambiguous" /><span>avoid l1IO0</span></label>
        </div>
      </div>
    </div>

    <div class="row gen-row">
      <input id="generated" class="input mono" readonly aria-label="Generated password" />
      <button type="button" class="btn btn-accent" id="generate">Generate</button>
      <CopyButton target="generated" />
      <button type="button" class="btn btn-sm" id="use">Test it above</button>
    </div>
  </section>
</ToolLayout>

<script>
  import { $, $$, esc, live, segmented } from '../../lib/dom';

  const passwordEl = $<HTMLInputElement>('#password');
  const revealEl = $<HTMLInputElement>('#reveal');
  const generatedEl = $<HTMLInputElement>('#generated');
  const lengthRange = $<HTMLInputElement>('#gen-length');
  const wordsRange = $<HTMLInputElement>('#gen-words');
  const noAmbiguousEl = $<HTMLInputElement>('#no-ambiguous');

  let genMode = 'random';

  const SETS: Record<string, string> = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digits: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{}<>?,.;:/|~',
  };

  const COMMON = new Set([
    'password', 'passw0rd', '123456', '12345678', '123456789', 'qwerty', 'abc123', 'letmein',
    'monkey', 'dragon', 'football', 'iloveyou', 'admin', 'welcome', 'login', 'master', 'sunshine',
    'princess', 'qwertyuiop', 'trustno1', 'baseball', 'superman', 'starwars', 'whatever',
  ]);

  const KEYBOARD = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm', '1234567890'];

  interface Analysis {
    entropy: number;
    pool: number;
    penalties: string[];
    checks: { label: string; pass: boolean }[];
  }

  function analyse(password: string): Analysis {
    const lower = password.toLowerCase();
    let pool = 0;
    if (/[a-z]/.test(password)) pool += 26;
    if (/[A-Z]/.test(password)) pool += 26;
    if (/\d/.test(password)) pool += 10;
    if (/[^A-Za-z0-9]/.test(password)) pool += 33;

    let entropy = password.length ? password.length * Math.log2(pool || 1) : 0;
    const penalties: string[] = [];

    if (COMMON.has(lower)) {
      entropy = Math.min(entropy, 8);
      penalties.push('This is one of the most-guessed passwords in every breach list.');
    }

    // Repeated characters carry far less information than the formula assumes.
    const unique = new Set(password).size;
    if (password.length > 3 && unique / password.length < 0.6) {
      entropy *= 0.7;
      penalties.push('Many characters repeat, which shrinks the real search space.');
    }

    if (/(.)\1{2,}/.test(password)) {
      entropy *= 0.85;
      penalties.push('Contains a run of three or more identical characters.');
    }

    if (/(?:012|123|234|345|456|567|678|789|890)/.test(password)) {
      entropy *= 0.85;
      penalties.push('Contains a numeric sequence.');
    }

    if (/(?:abc|bcd|cde|def|efg|xyz)/i.test(password)) {
      entropy *= 0.85;
      penalties.push('Contains an alphabetic sequence.');
    }

    for (const row of KEYBOARD) {
      for (let i = 0; i + 4 <= row.length; i++) {
        if (lower.includes(row.slice(i, i + 4))) {
          entropy *= 0.8;
          penalties.push('Contains a keyboard walk such as “qwer” or “asdf”.');
          i = row.length;
          break;
        }
      }
    }

    if (/^\d{4,8}$/.test(password)) {
      penalties.push('Digits only — a PIN-style password falls in seconds.');
    }

    if (/(19|20)\d{2}/.test(password)) {
      entropy *= 0.9;
      penalties.push('Contains something that looks like a year.');
    }

    const checks = [
      { label: 'At least 12 characters', pass: password.length >= 12 },
      { label: 'At least 16 characters (recommended)', pass: password.length >= 16 },
      { label: 'Lowercase letters', pass: /[a-z]/.test(password) },
      { label: 'Uppercase letters', pass: /[A-Z]/.test(password) },
      { label: 'Digits', pass: /\d/.test(password) },
      { label: 'Symbols', pass: /[^A-Za-z0-9]/.test(password) },
      { label: 'Not a well-known password', pass: !COMMON.has(lower) },
      { label: 'No character repeated three times', pass: !/(.)\1{2,}/.test(password) },
      { label: 'No obvious sequence', pass: !/(?:012|123|234|345|456|567|678|789|abc|xyz)/i.test(password) },
    ];

    return { entropy: Math.round(entropy * 10) / 10, pool, penalties: [...new Set(penalties)], checks };
  }

  const ATTACKERS: [string, number][] = [
    ['Online, rate-limited (100/s)', 1e2],
    ['Online, unthrottled (10k/s)', 1e4],
    ['Offline, bcrypt cost 12 (20k/s)', 2e4],
    ['Offline, slow hash (1M/s)', 1e6],
    ['Offline, fast GPU MD5 (100G/s)', 1e11],
    ['Nation state (100T/s)', 1e14],
  ];

  function humanTime(seconds: number): string {
    if (!Number.isFinite(seconds)) return 'longer than the universe has existed';
    if (seconds < 1) return 'instantly';
    const units: [number, string][] = [
      [60, 'second'],
      [60, 'minute'],
      [24, 'hour'],
      [365.25, 'day'],
      [1000, 'year'],
      [1000, 'millennium'],
    ];
    let value = seconds;
    let unit = 'second';
    for (const [size, name] of units) {
      unit = name;
      if (value < size) break;
      value /= size;
    }
    if (unit === 'millennium' && value > 1e6) return 'effectively forever';
    const rounded = value >= 100 ? Math.round(value) : Math.round(value * 10) / 10;
    return `${rounded.toLocaleString()} ${unit}${rounded === 1 ? '' : unit === 'millennium' ? 'a' : 's'}`;
  }

  function render() {
    const password = passwordEl.value;
    const { entropy, pool, penalties, checks } = analyse(password);

    $('#entropy').textContent = `${entropy} bits`;
    $('#pool').textContent = `pool ${pool}`;
    $('#length').textContent = `${password.length} chars`;

    const levels: { max: number; label: string; badge: string }[] = [
      { max: 28, label: 'Very weak', badge: 'badge-danger' },
      { max: 36, label: 'Weak', badge: 'badge-danger' },
      { max: 60, label: 'Reasonable', badge: 'badge-attention' },
      { max: 80, label: 'Strong', badge: 'badge-success' },
      { max: Infinity, label: 'Very strong', badge: 'badge-success' },
    ];
    const level = password
      ? levels.find((l) => entropy < l.max)!
      : { max: 0, label: 'Waiting', badge: 'badge-neutral' };
    const { label, badge: badgeClass } = level;

    const verdict = $('#verdict');
    verdict.textContent = label;
    verdict.className = `badge ${badgeClass}`;

    const meter = $('#meter');
    const pct = Math.min(100, (entropy / 100) * 100);
    meter.style.width = `${password ? Math.max(4, pct) : 0}%`;
    meter.style.background =
      entropy < 36
        ? 'var(--danger-emphasis)'
        : entropy < 60
          ? 'var(--attention-emphasis)'
          : entropy < 80
            ? 'var(--accent-emphasis)'
            : 'var(--success-emphasis)';

    // Average case is half the keyspace.
    const guesses = 2 ** entropy / 2;
    $('#crack tbody').innerHTML = ATTACKERS.map(
      ([name, rate]) => `<tr>
        <td>${esc(name)}</td>
        <td class="mono dim">${rate.toExponential(0)}</td>
        <td class="mono"><strong>${esc(password ? humanTime(guesses / rate) : '—')}</strong></td>
      </tr>`,
    ).join('');

    $('#checks').innerHTML = [
      ...checks.map(
        (c) =>
          `<li class="${c.pass ? 'ok' : 'no'}"><span>${c.pass ? '✓' : '✕'}</span>${esc(c.label)}</li>`,
      ),
      ...penalties.map((p) => `<li class="warn"><span>!</span>${esc(p)}</li>`),
    ].join('');
  }

  const pick = (pool: string) => pool[crypto.getRandomValues(new Uint32Array(1))[0] % pool.length];

  const WORDLIST =
    'anchor amber bison cactus cedar cobalt coral delta ember falcon fjord garnet harbor indigo ivory jasper kelp lagoon lantern maple meadow nimbus onyx opal orbit pebble quartz quill raven ripple saffron summit thistle timber umber valley velvet walnut willow zephyr zenith badger bramble canyon cinder dawn drift elm flint grove hollow juniper lichen marble nectar oakum pine prairie quiver reef sage shale spruce tundra vale wisp yarrow'.split(
      ' ',
    );

  function generate() {
    if (genMode === 'pin') {
      const size = Math.max(4, Math.min(12, Number(lengthRange.value)));
      generatedEl.value = Array.from({ length: size }, () => pick('0123456789')).join('');
      return;
    }

    if (genMode === 'passphrase') {
      const count = Number(wordsRange.value);
      const words = Array.from(
        { length: count },
        () => WORDLIST[crypto.getRandomValues(new Uint32Array(1))[0] % WORDLIST.length],
      );
      generatedEl.value = `${words.join('-')}-${pick('0123456789')}${pick('!@#$%&*')}`;
      return;
    }

    let pool = $$<HTMLInputElement>('.js-set')
      .filter((el) => el.checked)
      .map((el) => SETS[el.value])
      .join('');

    if (noAmbiguousEl.checked) pool = pool.replace(/[l1IO0oB8S5]/g, '');
    if (!pool) pool = SETS.lower;

    const size = Number(lengthRange.value);
    let value = '';
    for (let i = 0; i < size; i++) value += pick(pool);
    generatedEl.value = value;
  }

  revealEl.addEventListener('change', () => {
    passwordEl.type = revealEl.checked ? 'text' : 'password';
  });

  segmented($('#gen-mode'), (value) => {
    genMode = value;
    $('#opt-length').hidden = genMode === 'passphrase';
    $('#opt-words').hidden = genMode !== 'passphrase';
    $('#opt-sets').hidden = genMode !== 'random';
    generate();
  });

  $('#generate').addEventListener('click', generate);

  $('#use').addEventListener('click', () => {
    passwordEl.value = generatedEl.value;
    revealEl.checked = true;
    passwordEl.type = 'text';
    render();
  });

  live([lengthRange, wordsRange, noAmbiguousEl, ...$$('.js-set')], () => {
    $('#len-out').textContent = lengthRange.value;
    $('#words-out').textContent = wordsRange.value;
    generate();
  });

  live([passwordEl], render);
</script>

<style>
  .big {
    font-size: 16px;
    padding: 9px 14px;
  }

  .meter {
    height: 8px;
    background: var(--canvas-subtle);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .meter-fill {
    height: 100%;
    width: 0;
    border-radius: var(--radius-full);
    transition: width 0.18s ease, background 0.18s ease;
  }

  .summary {
    gap: 6px;
  }

  .toolbar {
    display: flex;
    align-items: flex-start;
    gap: 22px;
    flex-wrap: wrap;
  }

  .range {
    width: 190px;
    accent-color: var(--accent-emphasis);
  }

  .field b {
    font-family: var(--font-mono);
    color: var(--fg);
  }

  .gen-row {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-muted);
  }

  .gen-row .input {
    flex: 1;
    min-width: 200px;
    font-size: 15px;
  }

  .checks {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
  }

  .checks :global(li) {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 5px 16px;
    font-size: 13px;
  }

  .checks :global(li span) {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    border-radius: 50%;
  }

  .checks :global(li.ok span) {
    color: var(--success-fg);
    background: var(--success-subtle);
  }

  .checks :global(li.no span) {
    color: var(--danger-fg);
    background: var(--danger-subtle);
  }

  .checks :global(li.no) {
    color: var(--fg-muted);
  }

  .checks :global(li.warn) {
    color: var(--attention-fg);
  }

  .checks :global(li.warn span) {
    color: var(--attention-fg);
    background: var(--attention-subtle);
  }
</style>

---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout slug="palette-generator">
  <section class="card card-pad">
    <div class="toolbar">
      <div class="field">
        <label class="label" for="base">Base color</label>
        <div class="row">
          <input type="color" id="base" class="native" value="#0969da" />
          <input type="text" id="base-text" class="input mono base-text" value="#0969da" spellcheck="false" />
          <button type="button" class="btn btn-sm" id="random">Random</button>
        </div>
      </div>

      <div class="field">
        <span class="label">Harmony</span>
        <div class="segmented" id="harmony">
          <button type="button" data-value="complementary" aria-selected="true">Complementary</button>
          <button type="button" data-value="analogous">Analogous</button>
          <button type="button" data-value="triadic">Triadic</button>
          <button type="button" data-value="tetradic">Tetradic</button>
          <button type="button" data-value="split">Split</button>
          <button type="button" data-value="mono">Monochrome</button>
        </div>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <span class="card-title">Harmony</span>
      <span class="hint" id="harmony-hint"></span>
    </div>
    <div class="card-pad">
      <div class="swatches" id="harmony-out"></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <span class="card-title">Tonal scale</span>
      <span class="hint">50 → 950, the shape most design systems expect</span>
    </div>
    <div class="card-pad">
      <div class="scale" id="scale"></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <span class="card-title">Gradients</span>
      <div class="row">
        <label class="check"><input type="checkbox" id="gradient-angle" /><span>Diagonal (135°)</span></label>
      </div>
    </div>
    <div class="card-pad">
      <div class="gradients" id="gradients"></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <div class="segmented" id="export-format">
        <button type="button" data-value="css" aria-selected="true">CSS variables</button>
        <button type="button" data-value="scss">SCSS</button>
        <button type="button" data-value="tailwind">Tailwind</button>
        <button type="button" data-value="json">JSON</button>
      </div>
      <button type="button" class="btn btn-sm" data-copy-target="export-out">Copy</button>
    </div>
    <pre id="export-out" class="output"></pre>
  </section>
</ToolLayout>

<script>
  import { $, esc, live, segmented } from '../../lib/dom';
  import {
    BLACK,
    WHITE,
    formatHsl,
    hslToRgb,
    mix,
    parseColor,
    readableOn,
    rgbToHex,
    rgbToHsl,
    type RGB,
  } from '../../lib/color';

  const baseEl = $<HTMLInputElement>('#base');
  const baseTextEl = $<HTMLInputElement>('#base-text');
  const angleEl = $<HTMLInputElement>('#gradient-angle');

  const HARMONY_HINTS: Record<string, string> = {
    complementary: 'Opposite hues — maximum separation, great for accents and alerts.',
    analogous: 'Neighbouring hues — calm, cohesive, good for backgrounds.',
    triadic: 'Three evenly spaced hues — vivid but balanced.',
    tetradic: 'Two complementary pairs — rich, needs one dominant colour.',
    split: 'Complement split in two — contrast without the tension.',
    mono: 'One hue, varying saturation and lightness — quiet and safe.',
  };

  const SHIFTS: Record<string, number[]> = {
    complementary: [0, 180],
    analogous: [-30, 0, 30],
    triadic: [0, 120, 240],
    tetradic: [0, 90, 180, 270],
    split: [0, 150, 210],
    mono: [0],
  };

  const STEPS = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];

  let base: RGB = { r: 9, g: 105, b: 218, a: 1 };
  let harmony = 'complementary';
  let exportFormat = 'css';

  function harmonyColors(): { label: string; color: RGB }[] {
    const hsl = rgbToHsl(base);
    if (harmony === 'mono') {
      return [0.85, 0.6, 0.35, 0, 0.25, 0.5].map((amount, i) => ({
        label: i === 3 ? 'base' : i < 3 ? `light ${3 - i}` : `dark ${i - 3}`,
        color: i < 3 ? mix(base, WHITE, amount) : i === 3 ? base : mix(base, BLACK, amount),
      }));
    }
    return SHIFTS[harmony].map((shift) => ({
      label: shift === 0 ? 'base' : `${shift > 0 ? '+' : ''}${shift}°`,
      color: hslToRgb({ ...hsl, h: (hsl.h + shift + 360) % 360 }),
    }));
  }

  /** Blends toward white/black so the ramp keeps the base hue at step 500. */
  function scaleColors(): { step: number; color: RGB }[] {
    return STEPS.map((step) => {
      if (step === 500) return { step, color: base };
      const color =
        step < 500
          ? mix(base, WHITE, (500 - step) / 500 * 0.95)
          : mix(base, BLACK, (step - 500) / 450 * 0.82);
      return { step, color };
    });
  }

  function swatchHtml(color: RGB, label: string, sub = ''): string {
    const hex = rgbToHex(color).toUpperCase();
    return `<button type="button" class="swatch-btn" style="background:${hex};color:${readableOn(color)}" data-copy-value="${hex}" title="Copy ${hex}">
      <span class="swatch-label">${esc(label)}</span>
      <span class="swatch-hex">${hex}</span>
      ${sub ? `<span class="swatch-sub">${esc(sub)}</span>` : ''}
    </button>`;
  }

  function renderExport(colors: { step: number; color: RGB }[], harmonies: { label: string; color: RGB }[]) {
    const hexes = colors.map(({ step, color }) => [String(step), rgbToHex(color)] as const);

    if (exportFormat === 'css') {
      $('#export-out').textContent = `:root {\n${hexes
        .map(([k, v]) => `  --brand-${k}: ${v};`)
        .join('\n')}\n\n${harmonies
        .map((h, i) => `  --accent-${i + 1}: ${rgbToHex(h.color)}; /* ${h.label} */`)
        .join('\n')}\n}`;
    } else if (exportFormat === 'scss') {
      $('#export-out').textContent = hexes.map(([k, v]) => `$brand-${k}: ${v};`).join('\n');
    } else if (exportFormat === 'tailwind') {
      $('#export-out').textContent = `// tailwind.config.js\ncolors: {\n  brand: {\n${hexes
        .map(([k, v]) => `    ${k}: '${v}',`)
        .join('\n')}\n  },\n}`;
    } else {
      $('#export-out').textContent = JSON.stringify(
        {
          base: rgbToHex(base),
          harmony: Object.fromEntries(harmonies.map((h, i) => [h.label || `color-${i}`, rgbToHex(h.color)])),
          scale: Object.fromEntries(hexes),
        },
        null,
        2,
      );
    }
  }

  function renderGradients(harmonies: { label: string; color: RGB }[]) {
    const angle = angleEl.checked ? '135deg' : '90deg';
    const baseHex = rgbToHex(base);
    const partner = rgbToHex(harmonies[harmonies.length - 1].color);
    const hsl = rgbToHsl(base);

    const defs: [string, string][] = [
      ['Base → harmony', `linear-gradient(${angle}, ${baseHex}, ${partner})`],
      ['Light → dark', `linear-gradient(${angle}, ${rgbToHex(mix(base, WHITE, 0.7))}, ${rgbToHex(mix(base, BLACK, 0.5))})`],
      [
        'Hue sweep',
        `linear-gradient(${angle}, ${rgbToHex(hslToRgb({ ...hsl, h: (hsl.h + 330) % 360 }))}, ${baseHex}, ${rgbToHex(hslToRgb({ ...hsl, h: (hsl.h + 30) % 360 }))})`,
      ],
      ['Fade to transparent', `linear-gradient(${angle}, ${baseHex}, ${formatHsl({ ...base, a: 0 })})`],
      ['Radial glow', `radial-gradient(circle at 30% 30%, ${rgbToHex(mix(base, WHITE, 0.45))}, ${baseHex} 60%, ${rgbToHex(mix(base, BLACK, 0.4))})`],
      ['Mesh-ish', `conic-gradient(from ${Math.round(hsl.h)}deg, ${baseHex}, ${partner}, ${rgbToHex(mix(base, WHITE, 0.5))}, ${baseHex})`],
    ];

    $('#gradients').innerHTML = defs
      .map(
        ([label, css]) => `<div class="gradient">
          <div class="gradient-preview" style="background-image:${css}"></div>
          <div class="gradient-meta">
            <strong>${esc(label)}</strong>
            <code>${esc(css)}</code>
          </div>
          <button type="button" class="btn btn-sm" data-copy-value="${esc(`background-image: ${css};`)}">Copy</button>
        </div>`,
      )
      .join('');
  }

  function render() {
    const harmonies = harmonyColors();
    const scale = scaleColors();

    $('#harmony-hint').textContent = HARMONY_HINTS[harmony];
    $('#harmony-out').innerHTML = harmonies
      .map(({ label, color }) => swatchHtml(color, label, formatHsl(color)))
      .join('');
    $('#scale').innerHTML = scale.map(({ step, color }) => swatchHtml(color, String(step), '')).join('');

    renderGradients(harmonies);
    renderExport(scale, harmonies);
  }

  function setBase(value: string, from: 'picker' | 'text') {
    const parsed = parseColor(value);
    baseTextEl.classList.toggle('is-invalid', !parsed);
    if (!parsed) return;
    base = { ...parsed, a: 1 };
    if (from === 'text') baseEl.value = rgbToHex(base);
    else baseTextEl.value = rgbToHex(base);
    render();
  }

  baseEl.addEventListener('input', () => setBase(baseEl.value, 'picker'));
  baseTextEl.addEventListener('input', () => setBase(baseTextEl.value, 'text'));

  $('#random').addEventListener('click', () => {
    const hex = rgbToHex(
      hslToRgb({
        h: Math.random() * 360,
        s: 55 + Math.random() * 40,
        l: 40 + Math.random() * 20,
        a: 1,
      }),
    );
    setBase(hex, 'text');
    baseTextEl.value = hex;
  });

  segmented($('#harmony'), (value) => {
    harmony = value;
    render();
  });

  segmented($('#export-format'), (value) => {
    exportFormat = value;
    render();
  });

  live([angleEl], render);
</script>

<style>
  .toolbar {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .native {
    width: 46px;
    height: 32px;
    padding: 2px;
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .base-text {
    width: 130px;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
  }

  .scale {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  :global(.swatch-btn) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 10px;
    min-height: 84px;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-mono);
    transition: transform 0.12s ease;
  }

  .swatches :global(.swatch-btn) {
    border-radius: var(--radius-sm);
    justify-content: flex-end;
  }

  :global(.swatch-btn:hover) {
    transform: translateY(-2px);
    z-index: 1;
    box-shadow: var(--shadow-md);
  }

  :global(.swatch-label) {
    font-size: 11px;
    opacity: 0.85;
  }

  :global(.swatch-hex) {
    font-size: 12.5px;
    font-weight: 600;
  }

  :global(.swatch-sub) {
    font-size: 10px;
    opacity: 0.7;
  }

  .gradients {
    display: grid;
    gap: 10px;
  }

  .gradients :global(.gradient) {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-sm);
  }

  .gradients :global(.gradient-preview) {
    height: 46px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-muted);
  }

  .gradients :global(.gradient-meta) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .gradients :global(.gradient-meta strong) {
    font-size: 13px;
  }

  .gradients :global(.gradient-meta code) {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .scale {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .gradients :global(.gradient) {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .gradients :global(.gradient-preview) {
      grid-column: 1 / -1;
    }
  }
</style>

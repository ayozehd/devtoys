---
import ToolLayout from '../../layouts/ToolLayout.astro';
import CopyButton from '../../components/CopyButton.astro';

const SAMPLE =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6ImRldnRveXMtMSJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkFkYSBMb3ZlbGFjZSIsImVtYWlsIjoiYWRhQGV4YW1wbGUuY29tIiwicm9sZXMiOlsiYWRtaW4iLCJyZWFkZXIiXSwiaXNzIjoiaHR0cHM6Ly9hdXRoLmV4YW1wbGUuY29tIiwiYXVkIjoiZGV2dG95cy1hcHAiLCJpYXQiOjE3MzU2ODk2MDAsIm5iZiI6MTczNTY4OTYwMCwiZXhwIjoyMDUxMjIyNDAwLCJqdGkiOiJhYmMxMjMifQ.7cH1qy0K1Rm7g0Xj0R1Zk3Vp1G3xkKcJZ0Q9d1B2m4A';
---

<ToolLayout slug="jwt-decoder">
  <section class="card">
    <div class="card-head">
      <span class="card-title">Token</span>
      <div class="row">
        <span class="badge badge-neutral" id="status">Waiting</span>
        <button type="button" class="btn btn-sm" id="sample" data-sample={SAMPLE}>Load sample</button>
        <button type="button" class="btn btn-sm" id="clear">Clear</button>
      </div>
    </div>
    <div class="card-pad stack">
      <textarea
        id="token"
        class="textarea token"
        rows="5"
        spellcheck="false"
        placeholder="Paste a JWT — header.payload.signature"></textarea>
      <div id="colored" class="colored mono" aria-hidden="true"></div>
      <p id="error" class="flash flash-danger" hidden></p>
      <p class="flash flash-attention">
        This tool only <strong>decodes</strong>. It does not verify the signature, so never trust a
        token's contents based on what you see here. Nothing is sent anywhere — decoding happens in
        this tab.
      </p>
    </div>
  </section>

  <div class="grid-2">
    <section class="card">
      <div class="card-head">
        <span class="card-title">Header</span>
        <CopyButton target="header-out" />
      </div>
      <pre id="header-out" class="output"></pre>
    </section>

    <section class="card">
      <div class="card-head">
        <span class="card-title">Payload</span>
        <CopyButton target="payload-out" />
      </div>
      <pre id="payload-out" class="output"></pre>
    </section>
  </div>

  <section class="card">
    <div class="card-head">
      <span class="card-title">Registered claims</span>
      <span class="badge badge-neutral" id="expiry"></span>
    </div>
    <div class="table-wrap">
      <table class="data" id="claims">
        <thead>
          <tr><th>Claim</th><th>Name</th><th>Value</th><th>Meaning</th></tr>
        </thead>
        <tbody></tbody>
      </table>
      <p class="empty" id="no-claims">Decode a token to see its claims.</p>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <span class="card-title">Signature</span>
      <CopyButton target="signature-out" />
    </div>
    <div class="card-pad stack">
      <pre id="signature-out" class="output boxed"></pre>
      <p class="hint" id="alg-note"></p>
    </div>
  </section>
</ToolLayout>

<script>
  import { $, esc, live } from '../../lib/dom';

  const tokenEl = $<HTMLTextAreaElement>('#token');
  const errorEl = $('#error');
  const statusEl = $('#status');
  const coloredEl = $('#colored');

  const SAMPLE = $('#sample').dataset.sample ?? '';

  const CLAIMS: Record<string, { name: string; meaning: string; time?: boolean }> = {
    iss: { name: 'Issuer', meaning: 'Who created and signed this token.' },
    sub: { name: 'Subject', meaning: 'Who the token is about — usually a user id.' },
    aud: { name: 'Audience', meaning: 'Who the token is intended for.' },
    exp: { name: 'Expires at', meaning: 'Must be rejected on or after this time.', time: true },
    nbf: { name: 'Not before', meaning: 'Must be rejected before this time.', time: true },
    iat: { name: 'Issued at', meaning: 'When the token was created.', time: true },
    jti: { name: 'JWT ID', meaning: 'Unique identifier, used to prevent replay.' },
    alg: { name: 'Algorithm', meaning: 'Signing algorithm used for the signature.' },
    typ: { name: 'Type', meaning: 'Media type of the token — normally JWT.' },
    kid: { name: 'Key ID', meaning: 'Which key from the key set signed this token.' },
    scope: { name: 'Scope', meaning: 'Granted OAuth scopes.' },
    azp: { name: 'Authorised party', meaning: 'The client the token was issued to.' },
  };

  function decodeSegment(segment: string): unknown {
    const padded = segment.replace(/-/g, '+').replace(/_/g, '/');
    const full = padded + '='.repeat((4 - (padded.length % 4)) % 4);
    const bytes = Uint8Array.from(atob(full), (c) => c.charCodeAt(0));
    return JSON.parse(new TextDecoder().decode(bytes));
  }

  function fail(message: string) {
    tokenEl.classList.add('is-invalid');
    errorEl.hidden = false;
    errorEl.textContent = message;
    statusEl.textContent = 'Invalid';
    statusEl.className = 'badge badge-danger';
  }

  function reset() {
    $('#header-out').textContent = '';
    $('#payload-out').textContent = '';
    $('#signature-out').textContent = '';
    $('#claims tbody').innerHTML = '';
    $('#no-claims').hidden = false;
    $('#expiry').textContent = '';
    $('#alg-note').textContent = '';
    coloredEl.innerHTML = '';
  }

  function formatValue(key: string, value: unknown): string {
    if (CLAIMS[key]?.time && typeof value === 'number') {
      const date = new Date(value * 1000);
      return `${value} — ${date.toLocaleString()} (${date.toISOString()})`;
    }
    if (Array.isArray(value)) return value.join(', ');
    if (value && typeof value === 'object') return JSON.stringify(value);
    return String(value);
  }

  function run() {
    const token = tokenEl.value.trim().replace(/^bearer\s+/i, '');

    if (!token) {
      tokenEl.classList.remove('is-invalid');
      errorEl.hidden = true;
      statusEl.textContent = 'Waiting';
      statusEl.className = 'badge badge-neutral';
      reset();
      return;
    }

    const parts = token.split('.');
    if (parts.length !== 3) {
      reset();
      fail(`A JWT has three dot-separated parts; this one has ${parts.length}.`);
      return;
    }

    let header: Record<string, unknown>;
    let payload: Record<string, unknown>;
    try {
      header = decodeSegment(parts[0]) as Record<string, unknown>;
    } catch {
      reset();
      fail('The header is not valid base64url-encoded JSON.');
      return;
    }
    try {
      payload = decodeSegment(parts[1]) as Record<string, unknown>;
    } catch {
      reset();
      fail('The payload is not valid base64url-encoded JSON.');
      return;
    }

    tokenEl.classList.remove('is-invalid');
    errorEl.hidden = true;
    statusEl.textContent = 'Decoded';
    statusEl.className = 'badge badge-success';

    coloredEl.innerHTML = `<span class="seg-h">${esc(parts[0])}</span><span class="dot">.</span><span class="seg-p">${esc(
      parts[1],
    )}</span><span class="dot">.</span><span class="seg-s">${esc(parts[2])}</span>`;

    $('#header-out').textContent = JSON.stringify(header, null, 2);
    $('#payload-out').textContent = JSON.stringify(payload, null, 2);
    $('#signature-out').textContent = parts[2];

    const alg = String(header.alg ?? 'unknown');
    $('#alg-note').textContent =
      alg === 'none'
        ? 'alg is "none" — this token is unsigned and must never be trusted.'
        : `Signed with ${alg}. Verification needs the issuer's secret or public key and is deliberately not done here.`;

    const now = Math.floor(Date.now() / 1000);
    const exp = typeof payload.exp === 'number' ? payload.exp : null;
    const nbf = typeof payload.nbf === 'number' ? payload.nbf : null;
    const expiry = $('#expiry');

    if (exp === null) {
      expiry.textContent = 'No expiry claim';
      expiry.className = 'badge badge-attention';
    } else if (exp < now) {
      const ago = Math.round((now - exp) / 60);
      expiry.textContent = `Expired ${ago < 60 ? `${ago} min` : `${Math.round(ago / 60)} h`} ago`;
      expiry.className = 'badge badge-danger';
    } else if (nbf !== null && nbf > now) {
      expiry.textContent = 'Not valid yet';
      expiry.className = 'badge badge-attention';
    } else {
      const mins = Math.round((exp - now) / 60);
      expiry.textContent = `Valid for ${mins < 60 ? `${mins} min` : `${Math.round(mins / 60)} h`}`;
      expiry.className = 'badge badge-success';
    }

    const entries = [
      ...Object.entries(header).map(([k, v]) => [k, v, 'header'] as const),
      ...Object.entries(payload).map(([k, v]) => [k, v, 'payload'] as const),
    ];

    $('#no-claims').hidden = entries.length > 0;
    $('#claims tbody').innerHTML = entries
      .map(([key, value, where]) => {
        const meta = CLAIMS[key];
        return `<tr>
          <td class="mono"><strong>${esc(key)}</strong> <span class="badge badge-neutral">${where}</span></td>
          <td>${esc(meta?.name ?? '—')}</td>
          <td class="mono val">${esc(formatValue(key, value))}</td>
          <td class="dim">${esc(meta?.meaning ?? 'Custom claim.')}</td>
        </tr>`;
      })
      .join('');
  }

  $('#sample').addEventListener('click', () => {
    tokenEl.value = SAMPLE;
    run();
  });

  $('#clear').addEventListener('click', () => {
    tokenEl.value = '';
    run();
    tokenEl.focus();
  });

  live([tokenEl], run);
</script>

<style>
  .token {
    min-height: 110px;
    word-break: break-all;
  }

  .colored {
    padding: 10px 12px;
    font-size: 12.5px;
    line-height: 1.6;
    word-break: break-all;
    background: var(--canvas-subtle);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-sm);
    min-height: 42px;
  }

  .colored :global(.seg-h) {
    color: var(--danger-fg);
  }

  .colored :global(.seg-p) {
    color: var(--done-fg);
  }

  .colored :global(.seg-s) {
    color: var(--accent-fg);
  }

  .colored :global(.dot) {
    color: var(--fg-subtle);
  }

  .boxed {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    min-height: 56px;
  }
</style>

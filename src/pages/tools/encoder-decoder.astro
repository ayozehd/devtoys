---
import ToolLayout from '../../layouts/ToolLayout.astro';
import CopyButton from '../../components/CopyButton.astro';

const MODES = [
  { value: 'base64', label: 'Base64' },
  { value: 'base64url', label: 'Base64 URL' },
  { value: 'hex', label: 'Hex' },
  { value: 'url', label: 'URL' },
  { value: 'urlcomponent', label: 'URL component' },
  { value: 'binary', label: 'Binary' },
  { value: 'rot13', label: 'ROT13' },
];
---

<ToolLayout slug="encoder-decoder">
  <section class="card card-pad">
    <div class="controls">
      <div class="field">
        <span class="label">Format</span>
        <div class="segmented" id="mode" role="tablist" aria-label="Format">
          {
            MODES.map((m, i) => (
              <button type="button" role="tab" data-value={m.value} aria-selected={i === 0}>
                {m.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="field">
        <span class="label">Direction</span>
        <div class="segmented" id="direction" role="tablist" aria-label="Direction">
          <button type="button" role="tab" data-value="encode" aria-selected="true">Encode</button>
          <button type="button" role="tab" data-value="decode">Decode</button>
        </div>
      </div>

      <label class="check" id="wrap-wrap">
        <input type="checkbox" id="chunk" />
        <span>Wrap output at 76 chars</span>
      </label>
    </div>
  </section>

  <div class="grid-2">
    <section class="card">
      <div class="card-head">
        <span class="card-title" id="input-label">Plain text</span>
        <div class="row">
          <span class="badge badge-neutral" id="in-stats">0 chars</span>
          <button type="button" class="btn btn-sm" id="clear">Clear</button>
        </div>
      </div>
      <div class="card-pad">
        <textarea
          id="input"
          class="textarea"
          rows="12"
          spellcheck="false"
          placeholder="Type or paste here…">Hello, DevToys! ✨</textarea
        >
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <span class="card-title" id="output-label">Base64</span>
        <div class="row">
          <span class="badge badge-neutral" id="out-stats">0 chars</span>
          <button type="button" class="btn btn-sm" id="swap" title="Send output back to input">
            ↔ Use as input
          </button>
          <CopyButton target="output" />
        </div>
      </div>
      <div class="card-pad">
        <textarea id="output" class="textarea" rows="12" spellcheck="false" readonly></textarea>
      </div>
    </section>
  </div>

  <p id="error" class="flash flash-danger" hidden></p>

  <section class="card">
    <div class="card-head"><span class="card-title">Byte inspector</span></div>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr><th>Metric</th><th>Value</th></tr>
        </thead>
        <tbody id="inspector"></tbody>
      </table>
    </div>
  </section>
</ToolLayout>

<script>
  import { $, esc, live, segmented } from '../../lib/dom';

  const inputEl = $<HTMLTextAreaElement>('#input');
  const outputEl = $<HTMLTextAreaElement>('#output');
  const errorEl = $('#error');
  const chunkEl = $<HTMLInputElement>('#chunk');
  const inLabel = $('#input-label');
  const outLabel = $('#output-label');
  const inStats = $('#in-stats');
  const outStats = $('#out-stats');
  const inspector = $('#inspector');

  const LABELS: Record<string, string> = {
    base64: 'Base64',
    base64url: 'Base64 URL-safe',
    hex: 'Hex',
    url: 'URL encoded',
    urlcomponent: 'URL component encoded',
    binary: 'Binary',
    rot13: 'ROT13',
  };

  let mode = 'base64';
  let direction: 'encode' | 'decode' = 'encode';

  const enc = new TextEncoder();
  const dec = new TextDecoder('utf-8', { fatal: true });

  const toBase64 = (bytes: Uint8Array) => {
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin);
  };

  const fromBase64 = (text: string) => {
    const clean = text.replace(/[\s]/g, '').replace(/-/g, '+').replace(/_/g, '/');
    const padded = clean + '='.repeat((4 - (clean.length % 4)) % 4);
    const bin = atob(padded);
    return Uint8Array.from(bin, (c) => c.charCodeAt(0));
  };

  function encode(text: string): string {
    const bytes = enc.encode(text);
    switch (mode) {
      case 'base64':
        return toBase64(bytes);
      case 'base64url':
        return toBase64(bytes).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      case 'hex':
        return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join(' ');
      case 'url':
        return encodeURI(text);
      case 'urlcomponent':
        return encodeURIComponent(text);
      case 'binary':
        return Array.from(bytes, (b) => b.toString(2).padStart(8, '0')).join(' ');
      case 'rot13':
        return text.replace(/[a-z]/gi, (c) => {
          const base = c <= 'Z' ? 65 : 97;
          return String.fromCharCode(((c.charCodeAt(0) - base + 13) % 26) + base);
        });
      default:
        return text;
    }
  }

  function decode(text: string): string {
    switch (mode) {
      case 'base64':
      case 'base64url':
        return dec.decode(fromBase64(text));
      case 'hex': {
        const clean = text.replace(/(0x|[\s,:-])/gi, '');
        if (clean.length % 2) throw new Error('Hex input needs an even number of digits.');
        if (/[^0-9a-f]/i.test(clean)) throw new Error('Hex input contains non-hex characters.');
        const bytes = new Uint8Array(clean.length / 2);
        for (let i = 0; i < bytes.length; i++) {
          bytes[i] = parseInt(clean.slice(i * 2, i * 2 + 2), 16);
        }
        return dec.decode(bytes);
      }
      case 'url':
        return decodeURI(text);
      case 'urlcomponent':
        return decodeURIComponent(text);
      case 'binary': {
        const bits = text.replace(/[^01]/g, '');
        if (bits.length % 8) throw new Error('Binary input needs a multiple of 8 bits.');
        const bytes = new Uint8Array(bits.length / 8);
        for (let i = 0; i < bytes.length; i++) {
          bytes[i] = parseInt(bits.slice(i * 8, i * 8 + 8), 2);
        }
        return dec.decode(bytes);
      }
      case 'rot13':
        return encode(text);
      default:
        return text;
    }
  }

  function chunked(text: string): string {
    if (!chunkEl.checked) return text;
    return text.replace(/(.{76})/g, '$1\n');
  }

  function updateInspector(text: string) {
    const bytes = enc.encode(text);
    const lines = text === '' ? 0 : text.split('\n').length;
    const rows: [string, string][] = [
      ['Characters', String([...text].length)],
      ['UTF-8 bytes', String(bytes.length)],
      ['Lines', String(lines)],
      ['Words', String(text.trim() ? text.trim().split(/\s+/).length : 0)],
      ['Base64 size', `${Math.ceil(bytes.length / 3) * 4} chars`],
      [
        'First bytes',
        Array.from(bytes.slice(0, 12), (b) => b.toString(16).padStart(2, '0')).join(' ') || '—',
      ],
    ];
    inspector.innerHTML = rows
      .map(([k, v]) => `<tr><td>${esc(k)}</td><td class="mono">${esc(v)}</td></tr>`)
      .join('');
  }

  function run() {
    const text = inputEl.value;
    const encoding = direction === 'encode';
    inLabel.textContent = encoding ? 'Plain text' : LABELS[mode];
    outLabel.textContent = encoding ? LABELS[mode] : 'Plain text';
    $('#wrap-wrap').hidden = !encoding || (mode !== 'base64' && mode !== 'base64url');

    inStats.textContent = `${text.length} chars`;
    updateInspector(encoding ? text : outputEl.value);

    if (!text) {
      outputEl.value = '';
      outStats.textContent = '0 chars';
      errorEl.hidden = true;
      inputEl.classList.remove('is-invalid');
      return;
    }

    try {
      const result = encoding ? chunked(encode(text)) : decode(text);
      outputEl.value = result;
      outStats.textContent = `${result.length} chars`;
      errorEl.hidden = true;
      inputEl.classList.remove('is-invalid');
      updateInspector(encoding ? text : result);
    } catch (err) {
      outputEl.value = '';
      outStats.textContent = '0 chars';
      inputEl.classList.add('is-invalid');
      errorEl.hidden = false;
      errorEl.textContent = `Cannot decode as ${LABELS[mode]}: ${(err as Error).message}`;
    }
  }

  segmented($('#mode'), (value) => {
    mode = value;
    run();
  });

  segmented($('#direction'), (value) => {
    direction = value as 'encode' | 'decode';
    run();
  });

  $('#swap').addEventListener('click', () => {
    if (!outputEl.value) return;
    inputEl.value = outputEl.value;
    run();
  });

  $('#clear').addEventListener('click', () => {
    inputEl.value = '';
    run();
    inputEl.focus();
  });

  live([inputEl, chunkEl], run);
</script>

<style>
  .controls {
    display: flex;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }

  .controls .check {
    padding-bottom: 6px;
  }
</style>

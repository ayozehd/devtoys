---
import ToolLayout from '../../layouts/ToolLayout.astro';
import CopyButton from '../../components/CopyButton.astro';
---

<ToolLayout slug="uuid-generator">
  <section class="card card-pad">
    <div class="toolbar">
      <div class="field">
        <span class="label">Generator</span>
        <div class="segmented" id="kind">
          <button type="button" data-value="uuid4" aria-selected="true">UUID v4</button>
          <button type="button" data-value="uuid7">UUID v7</button>
          <button type="button" data-value="nil">Nil / Max</button>
          <button type="button" data-value="ulid">ULID</button>
          <button type="button" data-value="nanoid">Nano ID</button>
          <button type="button" data-value="string">Random string</button>
          <button type="button" data-value="number">Numbers</button>
          <button type="button" data-value="color">Colors</button>
          <button type="button" data-value="lorem">Lorem ipsum</button>
        </div>
      </div>
    </div>

    <div class="options">
      <label class="field opt" id="opt-count">
        <span class="label">How many</span>
        <input type="number" id="count" class="input" min="1" max="500" value="10" />
      </label>

      <label class="field opt" id="opt-length" hidden>
        <span class="label">Length</span>
        <input type="number" id="length" class="input" min="1" max="256" value="21" />
      </label>

      <label class="field opt" id="opt-min" hidden>
        <span class="label">Minimum</span>
        <input type="number" id="min" class="input" value="1" />
      </label>

      <label class="field opt" id="opt-max" hidden>
        <span class="label">Maximum</span>
        <input type="number" id="max" class="input" value="100" />
      </label>

      <div class="field opt" id="opt-charset" hidden>
        <span class="label">Character set</span>
        <div class="row">
          <label class="check"><input type="checkbox" class="js-charset" value="lower" checked /><span>a–z</span></label>
          <label class="check"><input type="checkbox" class="js-charset" value="upper" checked /><span>A–Z</span></label>
          <label class="check"><input type="checkbox" class="js-charset" value="digits" checked /><span>0–9</span></label>
          <label class="check"><input type="checkbox" class="js-charset" value="symbols" /><span>!@#$…</span></label>
        </div>
      </div>

      <div class="field opt">
        <span class="label">Formatting</span>
        <div class="row">
          <label class="check"><input type="checkbox" id="upper" /><span>Uppercase</span></label>
          <label class="check"><input type="checkbox" id="braces" /><span>Wrap in braces</span></label>
          <label class="check"><input type="checkbox" id="quotes" /><span>Quote &amp; comma</span></label>
        </div>
      </div>
    </div>

    <div class="row actions">
      <button type="button" class="btn btn-accent" id="generate">Generate</button>
      <CopyButton target="output" label="Copy all" />
      <button type="button" class="btn btn-sm" id="download">Download .txt</button>
      <span class="badge badge-neutral" id="meta"></span>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <span class="card-title">Output</span>
      <span class="hint" id="kind-hint"></span>
    </div>
    <pre id="output" class="output tall"></pre>
  </section>
</ToolLayout>

<script>
  import { $, $$, download as save, live, segmented } from '../../lib/dom';

  const countEl = $<HTMLInputElement>('#count');
  const lengthEl = $<HTMLInputElement>('#length');
  const minEl = $<HTMLInputElement>('#min');
  const maxEl = $<HTMLInputElement>('#max');
  const upperEl = $<HTMLInputElement>('#upper');
  const bracesEl = $<HTMLInputElement>('#braces');
  const quotesEl = $<HTMLInputElement>('#quotes');
  const outputEl = $('#output');

  let kind = 'uuid4';

  const HINTS: Record<string, string> = {
    uuid4: '122 bits of randomness from crypto.getRandomValues — the everyday choice.',
    uuid7: 'Time-ordered UUID (draft RFC 9562) — sorts by creation time, index-friendly.',
    nil: 'The all-zero and all-one UUIDs, useful as sentinels in tests.',
    ulid: '48-bit timestamp + 80 bits of entropy, Crockford base32, lexicographically sortable.',
    nanoid: 'URL-safe 21-character id — collision odds comparable to UUID v4.',
    string: 'Random string from the character sets you pick.',
    number: 'Uniform random integers in the range you set.',
    color: 'Random colors as hex, with the matching rgb() value.',
    lorem: 'Placeholder sentences for layout work.',
  };

  const bytes = (n: number) => crypto.getRandomValues(new Uint8Array(n));
  const hex = (arr: Uint8Array) => Array.from(arr, (b) => b.toString(16).padStart(2, '0')).join('');

  function uuid4(): string {
    if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    const b = bytes(16);
    b[6] = (b[6] & 0x0f) | 0x40;
    b[8] = (b[8] & 0x3f) | 0x80;
    const h = hex(b);
    return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
  }

  /** UUID v7: 48-bit big-endian timestamp, version/variant bits, then entropy. */
  function uuid7(): string {
    const b = bytes(16);
    const now = BigInt(Date.now());
    for (let i = 0; i < 6; i++) {
      b[i] = Number((now >> BigInt(8 * (5 - i))) & 0xffn);
    }
    b[6] = (b[6] & 0x0f) | 0x70;
    b[8] = (b[8] & 0x3f) | 0x80;
    const h = hex(b);
    return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
  }

  const CROCKFORD = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';

  function ulid(): string {
    let time = Date.now();
    let timePart = '';
    for (let i = 0; i < 10; i++) {
      timePart = CROCKFORD[time % 32] + timePart;
      time = Math.floor(time / 32);
    }
    const random = Array.from(bytes(16), (b) => CROCKFORD[b % 32]).join('');
    return timePart + random;
  }

  const NANO_ALPHABET = 'useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_GQZbfghjklqvwyzrict';

  function nanoid(size: number): string {
    return Array.from(bytes(size), (b) => NANO_ALPHABET[b % NANO_ALPHABET.length]).join('');
  }

  const CHARSETS: Record<string, string> = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digits: '0123456789',
    symbols: '!@#$%^&*()-_=+[]{};:,.?',
  };

  function randomString(size: number): string {
    const pool = $$<HTMLInputElement>('.js-charset')
      .filter((el) => el.checked)
      .map((el) => CHARSETS[el.value])
      .join('');
    if (!pool) return '';
    return Array.from(bytes(size), (b) => pool[b % pool.length]).join('');
  }

  /** Rejection sampling keeps the distribution uniform across the range. */
  function randomInt(min: number, max: number): number {
    const lo = Math.ceil(Math.min(min, max));
    const hi = Math.floor(Math.max(min, max));
    const range = hi - lo + 1;
    if (range <= 0) return lo;
    const limit = Math.floor(0xffffffff / range) * range;
    let value = 0;
    do {
      value = crypto.getRandomValues(new Uint32Array(1))[0];
    } while (value >= limit);
    return lo + (value % range);
  }

  const WORDS =
    'lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim ad minim veniam quis nostrud exercitation ullamco laboris nisi aliquip ex ea commodo consequat duis aute irure in reprehenderit voluptate velit esse cillum eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt culpa qui officia deserunt mollit anim id est laborum'.split(
      ' ',
    );

  function sentence(): string {
    const length = randomInt(8, 18);
    const words = Array.from({ length }, () => WORDS[randomInt(0, WORDS.length - 1)]);
    return `${words[0][0].toUpperCase()}${words[0].slice(1)} ${words.slice(1).join(' ')}.`;
  }

  function generateOne(): string {
    switch (kind) {
      case 'uuid4':
        return uuid4();
      case 'uuid7':
        return uuid7();
      case 'ulid':
        return ulid();
      case 'nanoid':
        return nanoid(Number(lengthEl.value) || 21);
      case 'string':
        return randomString(Number(lengthEl.value) || 16);
      case 'number':
        return String(randomInt(Number(minEl.value), Number(maxEl.value)));
      case 'color': {
        const b = bytes(3);
        return `#${hex(b)}  rgb(${b[0]}, ${b[1]}, ${b[2]})`;
      }
      case 'lorem':
        return sentence();
      default:
        return '';
    }
  }

  function decorate(value: string): string {
    let out = value;
    if (upperEl.checked) out = out.toUpperCase();
    if (bracesEl.checked) out = `{${out}}`;
    if (quotesEl.checked) out = `"${out}",`;
    return out;
  }

  function generate() {
    const count = Math.min(500, Math.max(1, Number(countEl.value) || 1));

    if (kind === 'nil') {
      outputEl.textContent = [
        decorate('00000000-0000-0000-0000-000000000000'),
        decorate('ffffffff-ffff-ffff-ffff-ffffffffffff'),
      ].join('\n');
      $('#meta').textContent = '2 values';
      return;
    }

    const values = Array.from({ length: count }, () => decorate(generateOne()));
    outputEl.textContent = values.join('\n');

    const unique = new Set(values).size;
    $('#meta').textContent = `${values.length} values · ${unique} unique`;
  }

  function syncOptions() {
    $('#kind-hint').textContent = HINTS[kind] ?? '';
    $('#opt-count').hidden = kind === 'nil';
    $('#opt-length').hidden = kind !== 'nanoid' && kind !== 'string';
    $('#opt-min').hidden = kind !== 'number';
    $('#opt-max').hidden = kind !== 'number';
    $('#opt-charset').hidden = kind !== 'string';
    lengthEl.value = kind === 'nanoid' ? '21' : lengthEl.value;
  }

  segmented($('#kind'), (value) => {
    kind = value;
    syncOptions();
    generate();
  });

  $('#generate').addEventListener('click', generate);
  $('#download').addEventListener('click', () => save(`${kind}.txt`, outputEl.textContent ?? ''));

  live(
    [countEl, lengthEl, minEl, maxEl, upperEl, bracesEl, quotesEl, ...$$('.js-charset')],
    generate,
  );

  syncOptions();
</script>

<style>
  .toolbar {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .options {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .opt .input {
    width: 120px;
  }

  .actions {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-muted);
  }

  .tall {
    min-height: 320px;
    max-height: 66vh;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { TOOLS, TOOLS_BY_CATEGORY } from '../lib/tools';
import { url } from '../lib/paths';
---

<BaseLayout
  title="DevToys"
  description={`${TOOLS.length} offline developer utilities — regex, cron, JSON, color, encoding and more.`}
>
  <section class="hero card card-pad">
    <div>
      <h2>Developer utilities that never leave your browser</h2>
      <p>
        {TOOLS.length} focused tools for everyday development and sysadmin work. No accounts, no
        uploads, no network calls — everything is computed locally and works offline once loaded.
      </p>
    </div>
    <div class="hero-search">
      <input
        type="search"
        id="home-search"
        class="input"
        placeholder="Search tools — try “json”, “cron”, “base64”…"
        autocomplete="off"
        aria-label="Search tools"
      />
    </div>
  </section>

  <div id="home-groups">
    {
      TOOLS_BY_CATEGORY.map((group) => (
        <section class="group" data-group>
          <h3 class="group-title">
            {group.category}
            <span class="badge badge-neutral">{group.tools.length}</span>
          </h3>
          <div class="cards">
            {group.tools.map((tool) => (
              <a
                class="tool-card"
                href={url(`/tools/${tool.slug}`)}
                data-name={`${tool.name} ${tool.description} ${tool.keywords.join(' ')}`.toLowerCase()}
              >
                <span class="tool-icon">
                  <Icon name={tool.icon} size={20} />
                </span>
                <span class="tool-body">
                  <strong>{tool.name}</strong>
                  <span>{tool.description}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p class="empty" id="home-empty" hidden>No tools match that search.</p>
</BaseLayout>

<script>
  const search = document.getElementById('home-search') as HTMLInputElement | null;
  const empty = document.getElementById('home-empty');

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;

    document.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
      let hits = 0;
      group.querySelectorAll<HTMLElement>('.tool-card').forEach((card) => {
        const match = !q || (card.dataset.name || '').includes(q);
        card.hidden = !match;
        if (match) hits++;
      });
      group.hidden = hits === 0;
      visible += hits;
    });

    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: linear-gradient(180deg, var(--canvas-subtle), var(--canvas));
  }

  .hero h2 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hero p {
    margin-top: 6px;
    max-width: 68ch;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .hero-search .input {
    height: 38px;
    max-width: 460px;
    border-radius: var(--radius-sm);
  }

  .group {
    margin-top: 26px;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: 12px;
  }

  .tool-card {
    display: flex;
    gap: 12px;
    padding: 14px;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color 0.14s ease, box-shadow 0.14s ease, transform 0.14s ease;
  }

  .tool-card:hover {
    text-decoration: none;
    border-color: var(--accent-emphasis);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .tool-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    color: var(--accent-fg);
    background: var(--accent-subtle);
    border: 1px solid var(--accent-muted);
    border-radius: 9px;
  }

  .tool-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .tool-body strong {
    font-size: 14px;
    font-weight: 600;
  }

  .tool-body span {
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--fg-muted);
  }

  @media (max-width: 560px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
